+    def read_cache_exclusions(self):
+        # DIFFSYNTH_CACHE_EXCLUDE_FILE names cached samples to skip at READ time. Nothing
+        # under the cache directory is written, renamed or deleted, so the (very expensive)
+        # cache stays valid and reverting the exclusion is just `unset`.
+        # One key per line; blank lines and #-comments ignored.
+        path = os.environ.get("DIFFSYNTH_CACHE_EXCLUDE_FILE")
+        if not path:
+            return set()
+        if not os.path.exists(path):
+            print(f"DIFFSYNTH_CACHE_EXCLUDE_FILE={path} does not exist; excluding nothing.")
+            return set()
+        keys = set()
+        with open(path, "r") as f:
+            for line in f:
+                line = line.split("#", 1)[0].strip()
+                if line:
+                    keys.add(line)
+        return keys
+
+    def apply_cache_exclusions(self):
+        # Matched against the absolute path, the basename and the stem, so a list stays
+        # valid whether the cache is named by data_id or by source stem.
+        keys = self.read_cache_exclusions()
+        if not keys:
+            return
+        def excluded(subpath):
+            base = os.path.basename(subpath)
+            return subpath in keys or base in keys or os.path.splitext(base)[0] in keys
+        before = len(self.cached_data)
+        self.cached_data = [p for p in self.cached_data if not excluded(p)]
+        # Counts only. The keys can derive from dataset filenames and are never printed.
+        print(f"cache exclusions: {before - len(self.cached_data)} of {before} excluded "
+              f"({len(keys)} keys listed), {len(self.cached_data)} remain.")
+
