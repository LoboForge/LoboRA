# post_stop_watcher runtime state. It writes to PSW_ARTIFACT_DIR outside the repo by
# default; these keep its log/state/lock out even if someone points it in here.
post_stop_watcher.state.json
post_stop_watcher.lock
post_stop_watcher.stdout
# lora_pull_watcher runtime state, same deal (LPW_ARTIFACT_DIR).
lora_pull_watcher.state.json
lora_pull_watcher.lock
lora_pull_watcher.stdout
# Dataset media and captions never belong in the repo. metadata.json/.csv embed the
# caption text verbatim, so they are as sensitive as the captions themselves.
dataset/
metadata.json
metadata.csv
# DIFFSYNTH_CACHE_EXCLUDE_FILE lists (RUNBOOK §13). The keys derive from dataset
# filenames. regen_cache_exclusions.py already refuses to write inside a work tree; this
# is the second line of defence for a hand-written or --allow-in-repo list.
cache_exclude*.txt
.DS_Store
.env
training.env
